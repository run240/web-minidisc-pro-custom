{
  "name": "electronwmd",
  "productName": "Web MiniDisc Pro",
  "version": "0.5.2-1.5.4",
  "description": "Electron version of WebMinidisc Pro",
  "homepage": "https://github.com/run240/web-minidisc-pro-custom",
  "repository": {
    "type": "git",
    "url": "https://github.com/run240/web-minidisc-pro-custom.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "./build-renderer.sh && ./run-fixes.sh && tsc",
    "build:custom": "node scripts/build-custom.mjs",
    "test:himd-edit-batch": "npm run build:custom && node scripts/test-himd-edit-batch.cjs",
    "test:i18n": "node scripts/check-windows-i18n.cjs",
    "pack:custom": "npm run build:custom && electron-builder --dir --win --x64",
    "release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-release.ps1",
    "start": "npm run build && NODE_ENV=development electron ./dist/main.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder -wl --x64 && electron-builder -w --ia32",
    "dist-mac": "./build-renderer.sh && ./run-fixes-macdist.sh && tsc && electron-builder -m --x64 && electron-builder -m --arm64"
  },
  "build": {
    "directories": {
      "output": "build",
      "buildResources": "res"
    },
    "artifactName": "${name}-${version}-${os}_${arch}.${ext}",
    "compression": "store",
    "asar": false,
    "win": {
      "icon": "./res/icon.ico",
      "executableName": "Web MiniDisc Pro"
    },
    "linux": {
      "icon": "./res/icon.png"
    },
    "files": [
      "node_modules",
      "dist",
      "renderer",
      "res",
      "extras",
      "SOURCE-MODIFICATIONS",
      "MODIFIED-BUILD-NOTICE.txt"
    ],
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "npmRebuild": false
  },
  "author": "asivery and contributors",
  "private": true,
  "dependencies": {
    "async-mutex": "^0.3.2",
    "electron-context-menu": "^3.6.1",
    "electron-prompt": "^1.7.0",
    "electron-store": "^8.1.0",
    "ffmpeg-static": "^5.3.0",
    "himd-js": "^0.2.12",
    "jconv": "^0.1.5",
    "jsbi": "^3.2.5",
    "msgpackr": "^1.11.2",
    "music-metadata": "^11.14.0",
    "netmd-exploits": "^0.5.12",
    "netmd-js": "^4.3.0",
    "netmd-tocmanip": "^0.1.5",
    "networkwm-js": "^0.2.3",
    "node-fetch": "^2.6.7",
    "nufatfs": "^0.1.10",
    "usb": "^2.13.0"
  },
  "devDependencies": {
    "@types/electron-prompt": "^1.6.5",
    "@types/node": "^18.11.9",
    "@types/node-fetch": "^2.6.2",
    "electron": "^31.2.1",
    "electron-builder": "^26.15.3",
    "prettier": "^2.7.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "yauzl": "^3.3.1"
  }
}
